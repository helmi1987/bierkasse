APP_NAME="Bierkasse"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Set by the setup wizard from the address the wizard is opened with (any domain).
APP_URL=http://localhost
APP_INSTALLED=false

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_CH
APP_TIMEZONE=Europe/Zurich

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=info

# Set by the setup wizard (mysql = MySQL/MariaDB, pgsql, sqlite).
# On Plesk change DB_HOST to 127.0.0.1 after the setup (CLI cannot reach the localhost socket).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=10080
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Mails are sent synchronously; no queue worker needed.
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Comma separated proxy IPs/CIDRs whose X-Forwarded-* headers are trusted (empty = none, "*" = all).
TRUSTED_PROXIES=

# Mail transport and SMTP are configured in the backend (Einstellungen).
MAIL_MAILER=sendmail
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -t -i"
